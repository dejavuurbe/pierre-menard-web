---
import BaseLayout from '../layouts/BaseLayout.astro';
const shopImage = '/pierre-menard-web/images/librairie-des-arenes.jpg';
---
<BaseLayout
  title="Librairie des Arènes — Pierre Menard"
  description="Librairie des Arènes en Nîmes, punto de venta de la edición de Don Quijote de la Mancha de monsieur Pierre Menard."
>
  <section class="acquisition-intro section section-half compact">
    <div class="container intro-inner">
      <a class="back" href={import.meta.env.BASE_URL}>← Retour à l’œuvre</a>
      <p class="eyebrow">Librairie · Nîmes</p>
      <p class="lead">La edición de <em>Don Quijote de la Mancha</em> de monsieur Pierre Menard se encuentra disponible exclusivamente en la Librairie des Arènes.</p>
    </div>
  </section>

  <section class="bookshop-section section section-screen compact">
    <div class="container bookshop">
      <figure>
        <img src={shopImage} alt="Fachada de la Librairie des Arènes en Nîmes" />
        <figcaption>Librairie des Arènes · Nîmes</figcaption>
      </figure>

      <div class="details">
        <p class="folio">Point de vente</p>
        <h1>Librairie des Arènes</h1>
        <address>17, rue des Arènes<br/>30000 Nîmes · France</address>

        <div class="rule"></div>

        <h2>Horaires</h2>
        <p>Lundi à samedi · 10 h — 19 h<br/>Dimanche · Fermé</p>

        <div class="rule"></div>

        <h2>Disponibilité</h2>
        <p>Los ejemplares pueden solicitarse directamente en el mostrador. Para reservas y consultas, dirigirse personalmente a la librería.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .acquisition-intro{
    border-bottom:1px solid var(--color-border);
  }

  .intro-inner{
    max-width:900px;
  }

  .back{
    display:inline-block;
    margin-bottom:1.2rem;
    color:var(--color-accent);
    text-transform:uppercase;
    letter-spacing:.15em;
    font-size:.68rem;
    text-decoration:none;
  }

  .acquisition-intro .lead{
    max-width:58ch;
    margin:.4rem 0 0;
    line-height:1.5;
  }

  .bookshop{
    display:grid;
    gap:clamp(2rem,6vw,4rem);
    align-items:center;
  }

  figure{
    margin:0;
  }

  figure img{
    width:100%;
    max-height:min(560px,calc(var(--section-full) - 6rem));
    object-fit:cover;
    filter:sepia(.16) contrast(.96);
    border:1px solid var(--color-border);
  }

  figcaption{
    margin-top:.5rem;
    font-size:.67rem;
    text-transform:uppercase;
    letter-spacing:.16em;
    color:var(--color-muted);
  }

  .folio{
    margin:0 0 .6rem;
    font-size:.68rem;
    text-transform:uppercase;
    letter-spacing:.22em;
    color:var(--color-accent);
  }

  .details h1{
    margin:0 0 .85rem;
    max-width:none;
    font-family:var(--font-display);
    font-size:clamp(2.4rem,4vw,3.7rem);
    line-height:.98;
    font-weight:400;
  }

  .details h2{
    margin:0 0 .45rem;
    font-family:var(--font-body);
    font-size:.68rem;
    line-height:1.2;
    text-transform:uppercase;
    letter-spacing:.18em;
    color:var(--color-accent);
  }

  address{
    font-family:var(--font-display);
    font-style:normal;
    font-size:1.08rem;
    line-height:1.55;
  }

  .details p{
    margin:.25rem 0 0;
    max-width:52ch;
    line-height:1.55;
  }

  .rule{
    height:1px;
    background:var(--color-border);
    margin:1.05rem 0;
  }

  @media(min-width:850px){
    .bookshop{
      grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);
    }
  }

  @media(max-width:919px){
    figure img{
      max-height:none;
    }
  }
</style>

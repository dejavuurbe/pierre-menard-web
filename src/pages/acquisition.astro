---
import BaseLayout from '../layouts/BaseLayout.astro';
const shopImage = '/pierre-menard-web/images/librairie-des-arenes.jpg';
---
<BaseLayout
  title="Librairie des Arènes — Pierre Menard"
  description="Librairie des Arènes en Nîmes, punto de venta de la edición de Don Quijote de la Mancha de monsieur Pierre Menard."
>
  <div class="acquisition">
    <a class="back" href={import.meta.env.BASE_URL}>← Retour à l’œuvre</a>
    <header class="intro">
      <p class="eyebrow">Librairie · Nîmes</p>
      <p class="lead">La edición de <em>Don Quijote de la Mancha</em> de monsieur Pierre Menard se encuentra disponible exclusivamente en la Librairie des Arènes.</p>
    </header>

    <section class="bookshop">
      <figure>
        <img src={shopImage} alt="Fachada de la Librairie des Arènes en Nîmes" />
        <figcaption>Librairie des Arènes · Nîmes</figcaption>
      </figure>
      <div class="details">
        <p class="folio">Point de vente</p>
        <h2>Librairie des Arènes</h2>
        <address>17, rue des Arènes<br/>30000 Nîmes · France</address>
        <div class="rule"></div>
        <h3>Horaires</h3>
        <p>Lundi à samedi · 10 h — 19 h<br/>Dimanche · Fermé</p>
        <div class="rule"></div>
        <h3>Disponibilité</h3>
        <p>Los ejemplares pueden solicitarse directamente en el mostrador. Para reservas y consultas, dirigirse personalmente a la librería.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .acquisition{max-width:1080px;margin:0 auto;padding:4rem 1.5rem 6rem}
  .back{display:inline-block;margin-bottom:4rem;color:var(--color-accent);text-transform:uppercase;letter-spacing:.15em;font-size:.68rem;text-decoration:none}
  .intro{max-width:760px;margin-bottom:3rem;border-bottom:1px solid var(--color-rule);padding-bottom:2.5rem}
  .eyebrow,.folio{font-size:.68rem;text-transform:uppercase;letter-spacing:.22em;color:var(--color-accent)}
  h1{font-family:var(--font-display);font-weight:400;font-size:clamp(2.8rem,7vw,5.7rem);line-height:.95;margin:.6rem 0 1.5rem}
  .lead{font-family:var(--font-display);font-size:1.3rem;line-height:1.6;max-width:650px}
  .bookshop{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);gap:3.5rem;align-items:start}
  figure{margin:0} figure img{display:block;width:100%;filter:sepia(.16) contrast(.96)}
  figcaption{margin-top:.7rem;font-size:.67rem;text-transform:uppercase;letter-spacing:.16em;color:var(--color-muted)}
  h2{font-family:var(--font-display);font-size:2.2rem;font-weight:400;margin:.5rem 0 1.4rem}
  h3{font-size:.67rem;text-transform:uppercase;letter-spacing:.18em;color:var(--color-accent);margin:0 0 .7rem}
  address{font-family:var(--font-display);font-style:normal;font-size:1.12rem;line-height:1.7}
  .details p{line-height:1.75}
  .rule{height:1px;background:var(--color-rule);margin:1.7rem 0}
  .note{margin-top:2rem;font-size:.7rem;font-style:italic;color:var(--color-muted)}
  @media(max-width:760px){.acquisition{padding-top:2.5rem}.back{margin-bottom:2.5rem}.bookshop{grid-template-columns:1fr;gap:2rem}}
</style>
